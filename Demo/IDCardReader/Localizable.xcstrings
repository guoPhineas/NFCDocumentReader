    "BAC Access" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BAC 访问"
          }
        }
      }
    },
    "BAC authenticates session messages, but does not verify the issuing authority's signature. Results stay in memory and are not uploaded." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BAC 会对会话消息进行认证，但不会验证签发机构的签名。结果仅保留在内存中，不会上传。"
          }
        }
      }
    },
    "BAC reads identity fields and additional personal details. PACE-only documents and extended MRZ document numbers are not supported yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BAC 可读取身份字段及其他个人详细信息。目前尚不支持仅支持 PACE 的证件以及扩展 MRZ 证件号码。"
          }
        }
      }
    },
    "Cancel Scan" : {
      "localizations" : {
        "zh-Hans" : {
